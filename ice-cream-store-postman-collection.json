	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{session_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Add required headers for all requests",
					"pm.request.headers.add({",
					"    key: 'X-User-ID',",
					"    value: pm.collectionVariables.get('user_id')",
					"});",
					"pm.request.headers.add({",
					"    key: 'X-Username',",
					"    value: pm.collectionVariables.get('username')",
					"});",
					"pm.request.headers.add({",
					"    key: 'X-User-Role',",
					"    value: pm.collectionVariables.get('user_role')",
					"});",
					"pm.request.headers.add({",
					"    key: 'X-User-Permissions',",
					"    value: pm.collectionVariables.get('user_permissions')",
					"});"
				]
			}
		}
	],
